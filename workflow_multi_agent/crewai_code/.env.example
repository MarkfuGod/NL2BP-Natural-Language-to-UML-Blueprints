# Model string, "<provider>/<model>". CrewAI 1.x has native clients for
# openai, anthropic, gemini, deepseek, ollama, openrouter, azure, bedrock.
# Anything else: install the extra  `uv sync --extra litellm`.
MODEL=anthropic/claude-sonnet-5-5
# MODEL=openai/gpt-5.1
# MODEL=deepseek/deepseek-chat
# MODEL=ollama/qwen3:14b

# Key for whichever provider MODEL names (only one is needed).
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=

# Optional
# NL2BP_TEMPERATURE=0.2
# NL2BP_OUTPUT_DIR=output
# NL2BP_LANGUAGE=中文
