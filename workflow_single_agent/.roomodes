# Roo Code custom modes for the NL2BP single-agent workflow.
# Install into a project:
#   .roomodes                      <- this file
#   .roo/rules-<slug>/             <- role_prompts/rules-<slug>/
#   skills/nl2bp/                  <- ../skills/nl2bp (references + nl2bp_check.py)
# In the rules, <skill> means the skills/nl2bp folder.
customModes:
  - slug: 01-req-gen
    name: "📝 Requirements"
    roleDefinition: Turn a natural-language request into requirements.md with user stories, business rules and use case / activity diagrams.
    whenToUse: Start here with a new request.
    groups: [read, edit, command]
  - slug: systemdesign
    name: "🏗️ Architecture"
    roleDefinition: Choose the smallest suitable stack and write architecture.md with ADRs and C4 context / container diagrams.
    whenToUse: After requirements.md exists.
    groups: [read, edit, command]
  - slug: blueprintdesign
    name: "📊 Blueprint"
    roleDefinition: Write blueprint.md, whose class diagrams are the implementation contract, plus sequence, ER and state diagrams, all passing PlantUML validation.
    whenToUse: After architecture.md exists.
    groups: [read, edit, command]
  - slug: coder
    name: "💻 Coder"
    roleDefinition: Implement the blueprint contract and its tests under code/, or apply a fix plan.
    whenToUse: After the blueprint validates, or with a fix plan from code-critic.
    groups: [read, edit, command]
  - slug: code-reviewer
    name: "🔍 Reviewer"
    roleDefinition: Review code against the blueprint, requirements and measured test/conformance results; end with a VERDICT line.
    whenToUse: After the coder finishes.
    groups: [read, command]
  - slug: code-critic
    name: "🛠️ Diagnosis"
    roleDefinition: Find root causes of reported defects and write a minimal fix plan for the coder.
    whenToUse: When the reviewer requests changes or tests fail.
    groups: [read, command]
  - slug: debugger-deployer
    name: "🚀 Deploy"
    roleDefinition: Verify the approved code runs and write deployment files and DEPLOY.md, reporting only what was actually executed.
    whenToUse: After the reviewer approves.
    groups: [read, edit, command]
